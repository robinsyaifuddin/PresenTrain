# PresenTrain Frontend Environment Template (Local / Production)
# Salin file ini menjadi `.env` lalu sesuaikan nilainya

# URL Backend API Laravel
VITE_BACKEND_URL=http://localhost:8000
VITE_BACKEND_LOCAL_URL=http://localhost:8000

# Google OAuth Client ID (Aman ditaruh di template, Client Secret TIDAK BOLEH di frontend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
